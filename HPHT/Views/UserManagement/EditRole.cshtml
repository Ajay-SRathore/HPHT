@model Microsoft.AspNetCore.Identity.IdentityUser

<h2>Edit Role</h2>

<form method="post">

    <input type="hidden"
           name="id"
           value="@Model.Id" />

    <div class="mb-3">
        <label>Email</label>

        <input class="form-control"
               value="@Model.Email"
               readonly />
    </div>

    <div class="mb-3">

        <label>Role</label>

        <select name="role"
                class="form-control">

            @foreach (var role in ViewBag.Roles)
            {
                <option value="@role.Name">
                    @role.Name
                </option>
            }

        </select>

    </div>

    <button type="submit"
            class="btn btn-success">
        Save
    </button>

</form>