<table class="table table-bordered">

    <thead>
        <tr>
            <th>Email</th>
            <th>User Name</th>
            <th>Role</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Email</td>

                <td>@item.UserName</td>

                <td>@item.Role</td>

                <td>
                    <a asp-action="EditRole"
                       asp-route-id="@item.Id"
                       class="btn btn-warning">
                        Change Role
                    </a>
                </td>

            </tr>
        }

    </tbody>

</table>