<form method="post">

    <input name="email"
           class="form-control" />

    <input name="password"
           type="password"
           class="form-control" />

    <select name="role"
            class="form-control">

        <option value="Admin">
            Admin
        </option>

        <option value="User">
            User
        </option>

    </select>

    <button type="submit"
            class="btn btn-success">
        Save
    </button>

</form>