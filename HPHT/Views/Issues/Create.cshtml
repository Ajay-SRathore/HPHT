@{
    ViewData["Title"] = "Create Issue";
}

<style>

    .create-card {
        background: #fff;
        padding: 24px;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,.08);
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .upload-box {
        background: #fafcff;
        border: 2px dashed #dce3ef;
        border-radius: 12px;
        padding: 20px;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
        margin-top: 32px;
    }

    .preview-card {
        margin-top: 24px;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        overflow-x: auto;
    }

    .preview-table {
        width: 100%;
        min-width: 1500px;
        border-collapse: collapse;
    }

        .preview-table th {
            background: #0d6efd;
            color: white;
            padding: 12px;
            border: 1px solid #d7e0ff;
        }

        .preview-table td {
            border: 1px solid #ddd;
            padding: 10px;
        }

        .preview-table tbody tr:nth-child(even) {
            background: #fafafa;
        }

        .preview-table tbody tr:hover {
            background: #eef5ff;
        }

</style>


<div class="create-card">

    <h2 class="page-title">
        Create Issue Stones
    </h2>


    <div class="upload-box">

        <div class="row g-3 align-items-end">


            <div class="col-md-4">

                <label>
                    Upload Image
                </label>

                <input type="file"
                       id="imageInput"
                       name="ImageFile"
                       accept="image/*"
                       class="form-control" />

            </div>



            <div class="col-md-4">

                <label>
                    Upload Excel
                </label>

                <input type="file"
                       id="fileInput"
                       class="form-control" />

            </div>



            <div class="col-md-4">

                <div class="action-buttons">

                    <button type="button"
                            class="btn btn-primary"
                            onclick="upload()">

                        Upload

                    </button>


                    <button type="button"
                            id="saveBtn"
                            class="btn btn-success"
                            onclick="save()"
                            disabled>

                        Save

                    </button>

                </div>

            </div>

        </div>

    </div>



    <div class="preview-card">

        <h5>
            Preview Records
        </h5>

        <div id="previewTable"></div>

    </div>

</div>



<script>

    let uploadedData = [];



    function upload() {

        const file =
            document
                .getElementById(
                    "fileInput"
                )
                .files[0];

        if (!file) {

            alert(
                "Select file"
            );

            return;

        }

        let fd =
            new FormData();

        fd.append(
            "file",
            file
        );

        fetch(
            "/api/issues/upload-preview",
            {
                method: "POST",
                body: fd
            }
        )

            .then(
                res => res.json()
            )

            .then(
                data => {

                    uploadedData = data;

                    renderTable(data);

                    document
                        .getElementById(
                            "saveBtn"
                        )
                        .disabled = false;

                });

    }



    function renderTable(data) {

        let html = `
    <table class="preview-table">

    <thead>

    <tr>

    <th>Sr No</th>
    <th>Client Name</th>
    <th>Client Code</th>
    <th>Client ID</th>
    <th>PCS</th>
    <th>Issue Weight</th>
    <th>Shape</th>
    <th>Issue Date</th>
    <th>Rough Type</th>
    <th>Return Date</th>
    <th>Return Weight</th>
    <th>Remarks</th>

    </tr>

    </thead>

    <tbody>
    `;

        data.forEach(r => {

            html += `
    <tr>

    <td>${r.srNo}</td>
    <td>${r.clientName}</td>
    <td>${r.clientCode}</td>
    <td>${r.clientId}</td>
    <td>${r.pcs}</td>
    <td>${r.issueWeight}</td>
    <td>${r.shape}</td>
    <td>${r.issueDate}</td>
    <td>${r.roughType}</td>
    <td>${r.returnDate}</td>
    <td>${r.returnWeight}</td>
    <td>${r.remarks}</td>

    </tr>
    `;

        });

        html += `
    </tbody>
    </table>
    `;

        document
            .getElementById(
                "previewTable"
            )
            .innerHTML =
            html;

    }



    function formatDate(dateStr) {

        if (!dateStr)
            return null;

        const parts =
            dateStr.split("-");

        if (parts.length !== 3)
            return null;

        return `${parts[2]}-${parts[1]}-${parts[0]}`;

    }



    async function save() {

        const finalData =
            uploadedData.map(
                x => ({

                    srNo:
                        x.srNo
                            ? parseInt(x.srNo)
                            : null,

                    clientName:
                        x.clientName,

                    clientCode:
                        x.clientCode
                            ? parseInt(x.clientCode)
                            : null,

                    kaid:
                        x.kaid,

                    ClientId:
                        x.clientId,

                    pcs:
                        x.pcs
                            ? parseInt(x.pcs)
                            : null,

                    issueWeight:
                        parseFloat(
                            x.issueWeight
                        ),

                    shape:
                        x.shape,

                    issueDate:
                        formatDate(
                            x.issueDate
                        ),

                    roughType:
                        x.roughType,

                    returnDate:
                        formatDate(
                            x.returnDate
                        ),

                    returnWeight:
                        parseFloat(
                            x.returnWeight
                        ),

                    remarks:
                        x.remarks

                })
            );


        let formData =
            new FormData();

        formData.append(
            "issues",
            JSON.stringify(
                finalData
            )
        );


        const fileInput =
            document.getElementById(
                "fileInput"
            );

        const imageInput =
            document.getElementById(
                "imageInput"
            );


        if (
            fileInput.files.length
        ) {

            for (
                let i = 0;
                i <
                fileInput.files.length;
                i++
            ) {

                formData.append(
                    "files",
                    fileInput.files[i]
                );

            }

        }


        if (
            imageInput.files.length
        ) {

            for (
                let i = 0;
                i <
                imageInput.files.length;
                i++
            ) {

                formData.append(
                    "images",
                    imageInput.files[i]
                );

            }

        }


        const response =
            await fetch(
                "/api/issues/save-issues",
                {
                    method: "POST",
                    body: formData
                }
            );


        if (
            response.ok
        ) {

            alert(
                "Records saved successfully"
            );

            window.location.href =
                "/Issues";

        }

        else {

            alert(
                "Error while saving"
            );

        }

    }

</script>