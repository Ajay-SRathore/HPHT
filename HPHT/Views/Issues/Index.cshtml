@model IEnumerable<HPHT.Models.Issues>

@{
    ViewData["Title"] = "Issue List";
}

<style>

    body {
        font-size: 11px;
    }

    h4 {
        margin-bottom: 10px;
        font-size: 20px;
        font-weight: 600;
    }

    .issue-card {
        background: white;
        padding: 8px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        overflow-x: auto;
    }

    .issue-table {
        width: 100%;
        min-width: 1700px;
        border-collapse: collapse;
        font-size: 10px;
    }

    .issue-table th {
        background: #0d6efd;
        color: white;
        border: 1px solid #d5e0ff;
        padding: 4px 5px;
        text-align: center;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
        font-size: 10px;
        font-weight: 600;
    }

    .issue-table td {
        border: 1px solid #ddd;
        padding: 3px 5px;
        white-space: nowrap;
        vertical-align: middle;
        line-height: 1.2;
    }

    .issue-table tbody tr:nth-child(even) {
        background: #fafafa;
    }

    .issue-table tbody tr:hover {
        background: #eef4ff;
    }

    .toolbar {
        margin-bottom: 8px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .toolbar p {
        margin: 0;
    }

    .toolbar .btn {
        font-size: 11px;
        padding: 4px 10px;
    }

    .form-control,
    .form-select {
        font-size: 11px;
        padding: 4px 6px;
        height: 30px;
    }

    .btn {
        font-size: 11px;
        padding: 4px 10px;
    }

   .pagination {
    margin-bottom: 8px;
}

.pagination .page-link {
    font-size: 11px;
    padding: 3px 8px;
}

.pagination .page-item.active .page-link {
    background: #0d6efd;
    border-color: #0d6efd;
}

.pagination .page-item.disabled .page-link {
    color: #999;
}

</style>

<h4>Issue List</h4>

<div class="toolbar">

    <p>
        <a asp-action="Create" class="btn btn-success">
            New Issue Stones
        </a>
    </p>

    <p>
        <a asp-action="Return" class="btn btn-success">
            Return Stones
        </a>
    </p>

    <p>
        <a asp-action="Repeat" class="btn btn-success">
            Repeat Stones
        </a>
    </p>

</div>

<form method="get"
      asp-action="Index"
      class="row g-2 mb-2">

    <div class="col-md-3">

        <input type="text"
               name="kaid"
               value="@Context.Request.Query["kaid"]"
               class="form-control"
               placeholder="Search KAID" />

    </div>

    <div class="col-md-3">

        <input type="text"
               name="clientId"
               value="@Context.Request.Query["clientId"]"
               class="form-control"
               placeholder="Search Client ID" />

    </div>

    <div class="col-md-3">

        <select name="ccode"
                class="form-select">

            <option value="">All Clients</option>

            @foreach (var c in ViewBag.Clients)
            {
                <option value="@c.Value"
                        selected="@(Context.Request.Query["ccode"]==c.Value)">
                    @c.Text
                </option>
            }

        </select>

    </div>

    <div class="col-md-3">

        <button class="btn btn-primary">
            Filter
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Reset
        </a>

    </div>

</form>

<div class="issue-card">

    <table class="issue-table">

        <thead>

            <tr>

                <th>KAID</th>
                <th>Client ID</th>
                <th>Lot No</th>
                <th>Client</th>
                <th>Pkt No</th>
                <th>PCS</th>
                <th>Issue Date</th>
                <th>Issue Wt</th>
                <th>Shape</th>
                <th>Exp</th>
                <th>Price</th>
                <th>Remarks</th>
                <th>Return Date</th>
                <th>Return Wt</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.KAID</td>
                    <td>@item.ClientId</td>
                    <td>@item.LotNo</td>
                    <td>@item.Client?.Name</td>
                    <td>@item.PktNo</td>
                    <td>@item.PCS</td>

                    <td>@item.IssueDate?.ToString("dd-MMM-yy")</td>

                    <td>@item.IssueWeight</td>

                    <td>@item.Shape</td>

                    <td>@item.Exp</td>

                    <td>@item.Price</td>

                    <td>@item.Remarks</td>

                    <td>@item.RETURNDATE?.ToString("dd-MMM-yy")</td>

                    <td>@item.RETURNWEIGHT</td>

                </tr>
            }

        </tbody>

    </table>

</div>

@if (ViewBag.TotalPages > 1)
{
    var current = (int)ViewBag.CurrentPage;
    var total = (int)ViewBag.TotalPages;

    <nav class="mb-2">
        <ul class="pagination pagination-sm justify-content-end">

            <!-- Previous -->
            <li class="page-item @(current == 1 ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new {
                        page = current - 1,
                        ccode = Context.Request.Query["ccode"],
                        kaid = Context.Request.Query["kaid"],
                        clientId = Context.Request.Query["clientId"]
                   })">
                    &laquo;
                </a>
            </li>

            @if (current > 3)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="@Url.Action("Index", new { page = 1, ccode = Context.Request.Query["ccode"], kaid = Context.Request.Query["kaid"], clientId = Context.Request.Query["clientId"] })">
                        1
                    </a>
                </li>

                @if (current > 4)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
            }

            @for (int i = Math.Max(1, current - 2); i <= Math.Min(total, current + 2); i++)
            {
                <li class="page-item @(i == current ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", new {
                            page = i,
                            ccode = Context.Request.Query["ccode"],
                            kaid = Context.Request.Query["kaid"],
                            clientId = Context.Request.Query["clientId"]
                       })">
                        @i
                    </a>
                </li>
            }

            @if (current < total - 2)
            {
                @if (current < total - 3)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }

                <li class="page-item">
                    <a class="page-link"
                       href="@Url.Action("Index", new {
                            page = total,
                            ccode = Context.Request.Query["ccode"],
                            kaid = Context.Request.Query["kaid"],
                            clientId = Context.Request.Query["clientId"]
                       })">
                        @total
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(current == total ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new {
                        page = current + 1,
                        ccode = Context.Request.Query["ccode"],
                        kaid = Context.Request.Query["kaid"],
                        clientId = Context.Request.Query["clientId"]
                   })">
                    &raquo;
                </a>
            </li>

        </ul>
    </nav>
}