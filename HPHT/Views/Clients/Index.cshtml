@model IEnumerable<HPHT.Models.Clients>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="mb-3">

    <input type="file"
           id="excelFile"
           class="form-control" />

    <button class="btn btn-success mt-2"
            onclick="uploadClients()">
        Upload Excel
    </button>

</div>
<script>

    async function uploadClients() {
        let file =
            document.getElementById("excelFile")
                .files[0];

        if (!file) {
            alert("Select Excel file");
            return;
        }

        let fd = new FormData();

        fd.append("file", file);

        let response =
            await fetch(
                "/api/clients/upload",
                {
                    method: "POST",
                    body: fd
                });

        if (response.ok) {
            alert("Clients uploaded successfully");
            location.reload();
        }
        else {
            let msg = await response.text();
            alert(msg);
        }
    }

</script>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ClientCode">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ClientCode">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ClientCode">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>


